# ============================================================
# RetainAI — environment variables
# Copy to .env at the repo root (and/or per-app .env files) and fill in.
# Nothing here is a real secret. Anything left blank falls back to a
# local mock so the stack still runs end-to-end without live accounts.
# ============================================================

# ---- Shopify ----
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_orders,write_orders,read_inventory,write_inventory,read_products,read_customers
SHOPIFY_APP_URL=http://localhost:3001
# Set to "mock" to use the built-in fake Shopify store (products/inventory/orders)
# instead of calling the real Admin API. Set to "live" once SHOPIFY_API_KEY/SECRET
# and a real shop are configured.
SHOPIFY_MODE=mock

# ---- OpenAI (AI Negotiator) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Set to "mock" to use a deterministic rule-based stand-in for the LLM
# (useful for CI / offline dev / anyone without an OpenAI key).
AI_MODE=mock

# ---- Supabase / Postgres ----
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/retainai
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ---- Shipping carriers ----
# Each defaults to "mock" (generates a fake label/tracking number locally).
# Switch to "live" once credentials are supplied.
DHL_MODE=mock
DHL_API_KEY=
DHL_API_SECRET=

FEDEX_MODE=mock
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=

UPS_MODE=mock
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=

# ---- Services ----
API_PORT=3001
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PORT=8000
WEB_PORT=3000
JWT_SECRET=dev-secret-change-me
